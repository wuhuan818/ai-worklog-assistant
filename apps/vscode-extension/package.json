{
    "name": "ai-worklog-assistant",
    "displayName": "AI Worklog Assistant",
    "publisher": "wuhuan818",
    "version": "0.1.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/wuhuan818/ai-worklog-assistant.git"
    },
    "engines": {
        "vscode": "^1.93.0"
    },
    "activationEvents": [
        "onStartupFinished",
        "onView:aiWorklog.sidebar"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aiWorklog",
                    "title": "AI Worklog",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "aiWorklog": [
                {
                    "id": "aiWorklog.sidebar",
                    "name": "Worklog",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            {
                "command": "aiWorklog.startTask",
                "title": "AI Worklog: Start Task"
            },
            {
                "command": "aiWorklog.endTask",
                "title": "AI Worklog: End Task"
            },
            {
                "command": "aiWorklog.createBug",
                "title": "AI Worklog: Create Bug"
            },
            {
                "command": "aiWorklog.resolveBug",
                "title": "AI Worklog: Resolve Bug"
            },
            {
                "command": "aiWorklog.addNote",
                "title": "AI Worklog: Add Note"
            },
            {
                "command": "aiWorklog.openReview",
                "title": "AI Worklog: Open Review"
            },
            {
                "command": "aiWorklog.searchKnowledge",
                "title": "AI Worklog: Search Knowledge Base"
            },
            {
                "command": "aiWorklog.askKnowledge",
                "title": "AI Worklog: 问知识库"
            },
            {
                "command": "aiWorklog.configureEmbedding",
                "title": "AI Worklog: 配置 Embedding Provider"
            },
            {
                "command": "aiWorklog.testEmbedding",
                "title": "AI Worklog: 测试 Embedding 连接"
            },
            {
                "command": "aiWorklog.rebuildSemanticIndex",
                "title": "AI Worklog: 重建语义索引"
            },
            {
                "command": "aiWorklog.restartServer",
                "title": "AI Worklog: Restart Local Server"
            },
            {
                "command": "aiWorklog.showLogs",
                "title": "AI Worklog: Show Logs"
            },
            {
                "command": "aiWorklog.configureAiProvider",
                "title": "AI Worklog: 配置 AI Provider"
            },
            {
                "command": "aiWorklog.switchAiProvider",
                "title": "AI Worklog: 切换 AI Provider"
            },
            {
                "command": "aiWorklog.testAiConnection",
                "title": "AI Worklog: 测试 AI 连接"
            },
            {
                "command": "aiWorklog.clearAiApiKey",
                "title": "AI Worklog: 清除 AI API Key"
            },
            {
                "command": "aiWorklog.deleteAiProvider",
                "title": "AI Worklog: 删除 AI Provider 配置"
            },
            {
                "command": "aiWorklog.previewAiContext",
                "title": "AI Worklog: 预览 AI 上下文"
            },
            {
                "command": "aiWorklog.rebuildAiContext",
                "title": "AI Worklog: 重新构建 AI 上下文"
            },
            {
                "command": "aiWorklog.markAiContextReady",
                "title": "AI Worklog: 将 AI 上下文标记为 Ready"
            },
            {
                "command": "aiWorklog.generateAiSummaryDraft",
                "title": "AI Worklog: 生成 AI 总结草稿"
            },
            {
                "command": "aiWorklog.viewAiSummaryDrafts",
                "title": "AI Worklog: 查看 AI 总结草稿"
            },
            {
                "command": "aiWorklog.exportApprovedSummary",
                "title": "AI Worklog: 导出已批准任务总结"
            },
            {
                "command": "aiWorklog.exportApprovedDailyReport",
                "title": "AI Worklog: 导出已批准日报"
            },
            {
                "command": "aiWorklog.publishKnowledgeCandidates",
                "title": "AI Worklog: 发布知识候选"
            },
            {
                "command": "aiWorklog.cancelAiSummaryGeneration",
                "title": "AI Worklog: 取消 AI 总结生成"
            }
        ],
        "configuration": {
            "title": "AI Worklog Assistant",
            "properties": {
                "aiWorklog.serverPort": {
                    "type": "number",
                    "default": 8765
                },
                "aiWorklog.eventCapture.enabled": {
                    "type": "boolean",
                    "default": true
                },
                "aiWorklog.eventCapture.debounceMs": {
                    "type": "number",
                    "default": 750
                },
                "aiWorklog.eventCapture.flushIntervalMs": {
                    "type": "number",
                    "default": 2000
                },
                "aiWorklog.eventCapture.maxFileSizeBytes": {
                    "type": "number",
                    "default": 1048576,
                    "minimum": 1024,
                    "maximum": 10485760
                },
                "aiWorklog.eventCapture.maxDiffBytes": {
                    "type": "number",
                    "default": 204800,
                    "minimum": 1024,
                    "maximum": 245000
                },
                "aiWorklog.eventCapture.terminalCommands": {
                    "type": "boolean",
                    "default": true,
                    "description": "在活动 Task 内通过 VS Code Shell Integration 捕获命令及退出状态；不捕获终端输出或环境变量。"
                },
                "aiWorklog.eventCapture.maxTerminalCommandBytes": {
                    "type": "number",
                    "default": 4096,
                    "minimum": 256,
                    "maximum": 8192,
                    "description": "单条终端命令在本地事件中的 UTF-8 字节上限。"
                },
                "aiWorklog.eventCapture.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "aiWorklog.serverPath": {
                    "type": "string",
                    "default": ""
                },
                "aiWorklog.dataDir": {
                    "type": "string",
                    "default": ""
                },
                "aiWorklog.enabled": {
                    "type": "boolean",
                    "default": false
                },
                "aiWorklog.baseUrl": {
                    "type": "string",
                    "default": ""
                },
                "aiWorklog.model": {
                    "type": "string",
                    "default": ""
                },
                "aiWorklog.aiContext.estimatedInputTokenBudget": {
                    "type": "number",
                    "default": 32000,
                    "minimum": 4000,
                    "maximum": 128000,
                    "description": "AI Context Package 的估算输入 Token 预算；不是实际计费 Token。"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p .",
        "lint": "eslint src --ext .ts",
        "test": "npm run compile && node --test dist/*.test.js dist/ai/*.test.js dist/ai/context/*.test.js dist/ai/generation/*.test.js test/vscodeTestLauncher.test.js",
        "test:e2e:event-capture": "node test/runEventCaptureE2E.js",
        "test:e2e:bug-lifecycle": "node test/runBugLifecycleE2E.js",
        "test:e2e:data-continuity": "node test/runDataContinuityE2E.js",
        "test:e2e:canary": "node test/runCanaryE2E.js",
        "test:e2e:ai-provider": "node test/runAiProviderE2E.js",
        "test:e2e:ai-provider-smoke": "node test/runAiProviderSmokeE2E.js"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "1.93.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "3.2.1",
        "eslint": "^8.57.0",
        "typescript": "^5.3.0"
    }
}
